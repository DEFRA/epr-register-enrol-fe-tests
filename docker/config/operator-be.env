PORT=8080
LOCALSTACK_ENDPOINT='http://floci:4566'
Mongo__DatabaseUri='mongodb://mongodb:27017/'
Mongo__DatabaseName=epr
ASPNETCORE_ENVIRONMENT=Development
CdpUploader__Url='http://cdp-uploader:7337'
App__BaseUrl='http://epr-register-enrol-backend:8080'
CaseWorking__Url='http://case-management-backend:8085'
CaseWorking__UseStub=false
# RA-425: seeds only the dedicated exporter (org 50018), for
# ra-425-view-ors-and-interim-sites.e2e.js. Not DevSeedData__Enabled, which
# would also seed Delta Green (org 50003), which other specs drive.
DevSeedData__ManageExporterEnabled=true
# RA-425: the registration status endpoint the /manage pages read.
FeatureFlags__InYearChangesEnabled=true
# RA-739: the backend's Development settings submit in-year change requests
# to case management, which this sandbox doesn't run, so keep it off here:
# RA-492's spec submits without it. The monorepo's @monorepo specs run with it on.
AccreditationChanges__SubmitToCaseManagement=false
