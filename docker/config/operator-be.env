PORT=8080
LOCALSTACK_ENDPOINT='http://floci:4566'
Mongo__DatabaseUri='mongodb://mongodb:27017/'
Mongo__DatabaseName=epr
ASPNETCORE_ENVIRONMENT=Development
CdpUploader__Url='http://cdp-uploader:7337'
App__BaseUrl='http://epr-register-enrol-backend:8080'
CaseWorking__Url='http://case-management-backend:8085'
CaseWorking__UseStub=false
# RA-425: seeds only the dedicated exporter (org 50018), for
# ra-425-view-ors-and-interim-sites.e2e.js. Not DevSeedData__Enabled, which
# would also seed Delta Green (org 50003), which other specs drive.
DevSeedData__ManageExporterEnabled=true
# RA-425: the registration status endpoint the /manage pages read.
FeatureFlags__InYearChangesEnabled=true
# RA-739: the backend's Development settings submit in-year change requests
# to case management, which this sandbox doesn't run, so keep it off here:
# RA-492's spec submits without it. The monorepo's @monorepo specs run with it on.
AccreditationChanges__SubmitToCaseManagement=false
# RA-806: seed dual-write, as cdp-app-config sets it for the backend in dev,
# test, ext-test, perf-test and prod (DualWriteSeed needs ExpandEnabled). It
# writes a seeded application's registration to the domain model with ReEx's
# registration status, so specs see what deployed environments see, not only
# the dev seeds' hard-coded Approved registrations.
DomainModel__ExpandEnabled=true
DomainModel__DualWriteSeed=true
# RA-751: service clients for ra-751-admin-legacy-status.e2e.js, which calls
# the backend's /admin API directly. "admin" is the one client the /admin
# routes accept (ServiceClientPolicies.AdminClientName); "reader" is any other
# known client, which they must refuse with 403. Obviously fake, sandbox-only
# secrets (the backend sets no length or format for them): the spec
# reads them from this file (test/helpers/admin-api.js), so they are defined
# once, here.
ServiceClients__Clients__0__Name=admin
ServiceClients__Clients__0__ClientId=epr-e2e-admin
AUTH_SHARED_SECRET__ADMIN=E2eComposeAdminToOperatorBackend
ServiceClients__Clients__1__Name=reader
ServiceClients__Clients__1__ClientId=epr-e2e-reader
AUTH_SHARED_SECRET__READER=E2eComposeReaderToOperatorBackend
