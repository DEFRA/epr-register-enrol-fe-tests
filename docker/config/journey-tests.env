# Environment for the test runner (not a container) on a run against this
# repo's compose stack: npm run test:github, test:github:serial and test:local
# load it with node --env-file, in CI (run-journey-tests) and locally alike.
# A variable already set in the shell wins over the value here.
#
# RA-751: the service clients the specs sign /admin API calls as
# (test/config.js, test/helpers/admin-api.js). Obviously fake, sandbox-only
# values, which must match the clients docker/config/operator-be.env
# registers on the compose backend, so change both together.
ADMIN_API_CLIENT_ID=epr-e2e-admin
ADMIN_API_CLIENT_SECRET=E2eComposeAdminToOperatorBackend
NON_ADMIN_API_CLIENT_ID=epr-e2e-reader
NON_ADMIN_API_CLIENT_SECRET=E2eComposeReaderToOperatorBackend
