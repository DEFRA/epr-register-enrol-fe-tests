# Copy to .env (git-ignored) and fill in. Read by npm run seed:organisation.

# Re/Ex environment to seed the organisation in. Leave unset for the local
# Re/Ex compose stack.
ENVIRONMENT=test

# CDP Developer API key. From outside CDP, epr-backend answers 403 unless the
# request goes through the ephemeral-protected gateway with this key. See
# https://github.com/DEFRA/cdp-documentation/blob/main/how-to/developer-api-key.md
X_API_KEY=

# The regulator (EA) Entra identity the seeding calls run as. test and
# ext-test sign in to real Entra, so all three are needed there.
ENTRA_CLIENT_SECRET=
ENTRA_USERNAME=
ENTRA_PASSWORD=


# Contact email the organisation application is submitted with in a deployed
# environment. Applying sends GOV.UK Notify emails to it, and test only allows
# Notify to send to REEXServiceTeam@defra.gov.uk: any other address fails the
# apply call with a 500.
EMAIL_ADDRESS=

# The contact email the organisation is given when it is approved, after the
# Notify emails have gone. Optional: a random address is used when unset.
ORG_CONTACT_EMAIL=

# npm run test:integration on ENVIRONMENT=test seeds an organisation with every
# material in onPrepare and signs each test in as its Defra ID user.
# Email the new organisation is linked for (default: a new example.com address)
DEFRA_ID_EMAIL=
# Reuse an organisation an earlier run seeded instead (its id, not the orgId).
# A reused organisation is never deleted at the end of the run.
SEEDED_ORGANISATION_ID=
# Every organisation a run seeds is listed in .integration/created-organisations.jsonl
# and deleted when the run completes (failures stay listed and are retried by
# the next run). Set to true to keep them, e.g. to inspect a failed run.
KEEP_SEEDED_ORGANISATIONS=
# Client secret of epr-register-enrol-frontend's own Defra ID stub, which the
# seeded user is also registered with. Defaults to the stub's published value.
REGISTER_ENROL_DEFRA_ID_CLIENT_SECRET=

# Case management (regulator) frontend the workflow tests query and approve
# applications in. Worked out from ENVIRONMENT when unset; this is test's.
CASE_MANAGEMENT_FRONTEND_URL=